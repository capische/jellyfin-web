# Host-specific settings for ./jellyfin-sync.
#
# Copy to jellyfin-sync.env, which is not tracked, and set what differs from the
# defaults. Nothing here needs to be set if the layout already matches.
#
#   cp jellyfin-sync.env.example jellyfin-sync.env

# SSH host for --local. An entry in ~/.ssh/config is the usual way to point this
# at the right user and address without repeating them here.
#JELLYFIN_SSH_HOST=jellyfin

# Base directory on the host, relative to the deploy account's home directory.
# The compose file and the web checkout are derived from it.
#JELLYFIN_MEDIA_DIR=media

# Override either of those individually if they sit elsewhere. Relative values
# are taken from the deploy account's home; absolute values are used as given.
#JELLYFIN_COMPOSE_FILE=media/server/docker-compose.yml
#JELLYFIN_WEB_DIR=media/src/jellyfin-web

# Git remote the host deploys from. The URL defaults to this checkout's origin.
#JELLYFIN_WEB_REMOTE=deployment
#JELLYFIN_WEB_FORK_URL=https://github.com/your/jellyfin-web.git
#JELLYFIN_WEB_BRANCH=master
