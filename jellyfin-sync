#!/usr/bin/env bash
#
# Deploy jellyfin-web to the Jellyfin host.
#
# The host serves the built bundle straight from this checkout's dist/, which the
# Jellyfin container bind-mounts, so deploying means getting a fresh dist/ there
# and restarting the container.
#
#   jellyfin-sync            Build on the host from the deployment branch. Needs
#                            nothing locally, but a Raspberry Pi spends roughly
#                            six minutes in webpack alone.
#
#   jellyfin-sync --local    Build dist/ here and rsync it over. The bundle is
#                            plain JS/CSS/wasm with nothing host-specific in it,
#                            so a workstation build runs fine on the Pi.
#
# Run with DEBUG=1 to trace.

set -euo pipefail

[[ -n ${DEBUG:-} ]] && set -x

# Resolved before the re-exec below, which moves the running copy to a temp file.
if [[ -n ${JELLYFIN_SYNC_ROOT:-} ]]; then
    readonly SCRIPT_DIR="$JELLYFIN_SYNC_ROOT"
else
    readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
fi

# Bash reads a script incrementally, so checking out another revision would
# corrupt this file mid-run. Hand over to a copy outside the checkout first.
if [[ -z ${JELLYFIN_SYNC_REEXEC:-} ]]; then
    self="$(mktemp "${TMPDIR:-/tmp}/jellyfin-sync.XXXXXX")"
    cp -- "${BASH_SOURCE[0]}" "$self"
    # No -- here: BSD chmod treats it as a file name.
    chmod +x "$self"
    JELLYFIN_SYNC_REEXEC="$self" JELLYFIN_SYNC_ROOT="$SCRIPT_DIR" exec "$self" "$@"
fi
# Preserve the status the script exited with; a bare trap would report the
# status of its own last command instead.
plugin_package_dir=''
cleanup() {
    local status=$?
    rm -f -- "$JELLYFIN_SYNC_REEXEC"
    if [[ -n ${plugin_package_dir:-} ]]; then
        rm -rf -- "$plugin_package_dir"
    fi
    exit "$status"
}
trap cleanup EXIT

# Anything host-specific belongs in jellyfin-sync.env, which is not tracked.
# See jellyfin-sync.env.example.
readonly CONFIG_FILE="${JELLYFIN_SYNC_CONFIG:-$SCRIPT_DIR/jellyfin-sync.env}"
if [[ -f $CONFIG_FILE ]]; then
    # shellcheck source=/dev/null
    . "$CONFIG_FILE"
fi

readonly DEPLOY_REMOTE="${JELLYFIN_WEB_REMOTE:-deployment}"
# Prefer the remote the host already deploys from; fall back to origin for a
# checkout that has not been set up yet.
readonly DEPLOY_URL="${JELLYFIN_WEB_FORK_URL:-$(
    git -C "$SCRIPT_DIR" remote get-url "$DEPLOY_REMOTE" 2>/dev/null ||
        git -C "$SCRIPT_DIR" remote get-url origin 2>/dev/null
)}"
readonly DEPLOY_BRANCH="${JELLYFIN_WEB_BRANCH:-master}"
readonly SSH_HOST="${JELLYFIN_SSH_HOST:-jellyfin}"

# Paths are taken relative to the deploy account's home directory, so the same
# values work whether the script runs on the host or drives it over ssh. An
# absolute value is used as given.
readonly MEDIA_DIR="${JELLYFIN_MEDIA_DIR:-media}"
readonly COMPOSE_FILE="${JELLYFIN_COMPOSE_FILE:-$MEDIA_DIR/server/docker-compose.yml}"
readonly WEB_DIR="${JELLYFIN_WEB_DIR:-$MEDIA_DIR/src/jellyfin-web}"
readonly TEST_COMPOSE_FILE="${JELLYFIN_TEST_COMPOSE_FILE:-$MEDIA_DIR/server/docker-compose.jellyfinmod-test.yml}"
readonly TEST_WEB_DIR="${JELLYFIN_TEST_WEB_DIR:-$MEDIA_DIR/test/jellyfinmod/web}"
readonly TEST_PLUGIN_DIR="${JELLYFIN_TEST_PLUGIN_DIR:-$MEDIA_DIR/test/jellyfinmod/config/plugins/JellyfinMod}"

mode=host
target=web
build=1
restart=1
test_instance=0
plugin_web=0

die() {
    echo "$*" >&2
    exit 2
}

usage() {
    cat <<'EOF'
Deploy jellyfin-web to the Jellyfin host.

The host serves the built bundle straight from this checkout's dist/, which the
Jellyfin container bind-mounts, so deploying means getting a fresh dist/ there
and restarting the container.

  jellyfin-sync            Build on the host from the deployment branch. Needs
                           nothing locally, but a Raspberry Pi spends roughly
                           six minutes in webpack alone.

  jellyfin-sync --local    Build dist/ here and rsync it over. The bundle is
                           plain JS/CSS/wasm with nothing host-specific in it,
                           so a workstation build runs fine on the Pi.

Options:
  -l, --local        Build dist/ locally and rsync it to the host.
      --plugin       With --local, deploy only JellyfinMod; leave dist/ untouched.
      --plugin-web   With --local --test, build dist/, zip it into jellyfinmod-web.zip and
                     deploy JellyfinMod with that bundle, which the plugin serves and puts
                     at /web itself. The host's web directory is not synced.
      --test         Target the isolated jellyfinmod-test service, never the default service.
      --host HOST    SSH host for --local.
      --path PATH    Web checkout, relative to the deploy account's home.
      --no-build     With --local, sync the existing target without rebuilding.
      --no-restart   Leave the Jellyfin container alone after deploying.
  -h, --help         Show this message.

Run with DEBUG=1 to trace.
EOF
}

while (($#)); do
    case "$1" in
        -l | --local) mode=local ;;
        --plugin) target=plugin ;;
        --plugin-web)
            target=plugin
            plugin_web=1
            ;;
        --test) test_instance=1 ;;
        --host)
            [[ $# -ge 2 ]] || die "--host needs a value"
            SSH_HOST_OVERRIDE="$2"
            shift
            ;;
        --path)
            [[ $# -ge 2 ]] || die "--path needs a value"
            WEB_DIR_OVERRIDE="$2"
            shift
            ;;
        --no-build) build=0 ;;
        --no-restart) restart=0 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            die "Unknown option: $1"
            ;;
    esac
    shift
done

ssh_host="${SSH_HOST_OVERRIDE:-$SSH_HOST}"
compose_file="$COMPOSE_FILE"
compose_service=jellyfin
web_dir="${WEB_DIR_OVERRIDE:-$WEB_DIR}"
plugin_dir_default="${JELLYFIN_PLUGIN_DIR:-$MEDIA_DIR/config/jellyfin/plugins/JellyfinMod}"

if ((test_instance)); then
    [[ $mode == local ]] || die "--test requires --local; isolated test deployments use local artifacts."
    compose_file="$TEST_COMPOSE_FILE"
    compose_service=jellyfinmod-test
    web_dir="${WEB_DIR_OVERRIDE:-$TEST_WEB_DIR}"
    plugin_dir_default="$TEST_PLUGIN_DIR"
fi

if [[ $target == plugin && $mode != local ]]; then
    die "--plugin requires --local; the plugin is built from the local plugin checkout."
fi

# The bundle is mod work: it only ever goes to the isolated instance.
if ((plugin_web && !test_instance)); then
    die "--plugin-web requires --test; the plugin-served interface is never deployed to production."
fi

rule() {
    echo "-------------------------------------------------"
}

# The host's login shell is not necessarily bash, and quoting a command through
# it is fragile. Feed the script over stdin instead so only bash ever parses it.
remote() {
    ssh "$ssh_host" bash -ls
}

restart_jellyfin_remote() {
    echo "Restarting $compose_service on $ssh_host..."
    # \$HOME stays unexpanded so it resolves on the host, not here.
    remote <<EOF
cd "\$HOME" || exit 1
docker compose -f '$compose_file' restart '$compose_service'
EOF
}

deploy_on_host() {
    cd "$SCRIPT_DIR"

    rule
    echo "Updating Jellyfin Web from ${DEPLOY_URL} (${DEPLOY_BRANCH})..."
    rule

    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "Refusing to deploy because the checkout has tracked changes." >&2
        echo "Commit or discard them before running this script." >&2
        exit 1
    fi

    [[ -n $DEPLOY_URL ]] || die "No deploy URL. Set JELLYFIN_WEB_FORK_URL in $CONFIG_FILE."

    if git remote get-url "$DEPLOY_REMOTE" >/dev/null 2>&1; then
        git remote set-url "$DEPLOY_REMOTE" "$DEPLOY_URL"
    else
        git remote add "$DEPLOY_REMOTE" "$DEPLOY_URL"
    fi

    echo "Fetching the deployment branch..."
    git fetch --prune "$DEPLOY_REMOTE" "$DEPLOY_BRANCH"

    echo "Checking out the exact deployment revision..."
    git checkout -B "$DEPLOY_BRANCH" "$DEPLOY_REMOTE/$DEPLOY_BRANCH"
    echo "Deploying commit $(git rev-parse --short HEAD)"

    echo
    rule
    echo "Installing locked dependencies..."
    npm ci

    echo "Building production assets..."
    npm run build:production

    if ((restart)); then
        echo "Restarting Jellyfin..."
        (cd "$HOME" && docker compose -f "$compose_file" restart "$compose_service")
    fi
}

deploy_from_local() {
    cd "$SCRIPT_DIR"

    rule
    echo "Deploying a local build to ${ssh_host}:${web_dir}/dist"
    rule

    local revision
    revision="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    if git diff --quiet && git diff --cached --quiet; then
        echo "Building commit $revision"
    else
        echo "Building commit $revision plus uncommitted changes."
        echo "The host will be running a bundle that matches no revision."
    fi

    if ((build)); then
        echo
        echo "Building production assets..."
        npm run build:production
    fi

    # An empty or half-written dist/ must never reach the host: the sync mirrors
    # deletions, so shipping one would leave Jellyfin serving nothing at all.
    if [[ ! -s dist/index.html ]]; then
        echo "dist/index.html is missing or empty, refusing to sync." >&2
        echo "Drop --no-build, or run npm run build:production first." >&2
        exit 1
    fi

    echo
    echo "Syncing dist/..."
    # Into the directory, never over it: the container bind-mounts this exact
    # path, and replacing it would leave the mount on the old, orphaned inode.
    # Keep content-hashed chunks from prior builds because resident TV clients
    # continue requesting their original bundle until the app is fully closed.
    rsync --archive --compress --human-readable --stats \
        dist/ "$ssh_host:$web_dir/dist/"

    if ((restart)); then
        restart_jellyfin_remote
    fi
}

# Build dist/ and zip it, without source maps, as the bundle the plugin serves (PHASE7 §4.5).
package_web_bundle() {
    local binary_dir="$1"
    cd "$SCRIPT_DIR"
    if ((build)); then
        npm run build:production
    fi
    local required
    for required in index.html jellyfinmod.html jellyfinmod-web.json; do
        [[ -s dist/$required ]] || die "dist/$required is missing or empty; refusing to package the bundle."
    done
    mkdir -p "$binary_dir"
    binary_dir="$(cd -- "$binary_dir" && pwd)"
    rm -f "$binary_dir/jellyfinmod-web.zip"
    (cd dist && zip -q -r -X "$binary_dir/jellyfinmod-web.zip" . -x '*.map')
    echo "Packaged web bundle $(sed -n 's/.*"bundleId": *"\([^"]*\)".*/\1/p' dist/jellyfinmod-web.json | head -n 1)"
}

deploy_plugin_from_local() {
    local project="${JELLYFIN_PLUGIN_PROJECT:-$SCRIPT_DIR/../plugin/JellyfinMod/JellyfinMod.csproj}"
    local plugin_dir="$plugin_dir_default"
    local dotnet="${JELLYFIN_DOTNET:-dotnet}"
    local python="${JELLYFIN_PLUGIN_PYTHON:-python3}"
    local binary_dir="$(dirname -- "$project")/bin/Release/net10.0"
    local package_script="$(dirname -- "$(dirname -- "$project")")/scripts/package_plugin.py"

    [[ -f $project ]] || die "Plugin project missing: $project"
    if ((build)); then
        "$dotnet" build -c Release "$project"
    fi
    [[ -f $package_script ]] || die "Plugin packaging script missing: $package_script"
    if ((plugin_web)); then
        package_web_bundle "$binary_dir"
    fi
    plugin_package_dir="$(mktemp -d "${TMPDIR:-/tmp}/jellyfin-plugin.XXXXXX")"
    "$python" "$package_script" "$binary_dir" "$plugin_package_dir"
    # Values are embedded in a single-quoted remote command below.
    [[ $plugin_dir != *"'"* && $plugin_dir != *$'\n'* ]] || die "Plugin path cannot contain quotes or newlines."
    [[ -n $plugin_dir && $plugin_dir != / && $plugin_dir != . ]] || die "Set a dedicated plugin folder."

    echo "Deploying JellyfinMod to ${ssh_host}:${plugin_dir}/"
    # Preserve the administrator's enable/disable and auto-update choices when
    # replacing generated metadata. Configuration XML and the database are elsewhere.
    remote > "$plugin_package_dir/existing-meta.json" <<EOF
set -eu
cd "\$HOME"
if [[ -f '$plugin_dir/meta.json' ]]; then
    cat -- '$plugin_dir/meta.json'
fi
EOF
    "$python" - "$plugin_package_dir" <<'PY'
import json
import pathlib
import sys
folder = pathlib.Path(sys.argv[1])
existing = folder / 'existing-meta.json'
if existing.stat().st_size:
    old = json.loads(existing.read_text())
    manifest = folder / 'meta.json'
    new = json.loads(manifest.read_text())
    if old.get('guid') != new['guid']:
        raise SystemExit('Target folder belongs to another plugin; refusing to overwrite it.')
    for key in ('status', 'autoUpdate'):
        if key in old:
            new[key] = old[key]
    manifest.write_text(json.dumps(new, indent=4) + '\n')
PY
    remote <<EOF
set -eu
cd "\$HOME"
mkdir -p -- '$plugin_dir'
EOF
    # Copy only the generated package files, without --delete; other plugins stay intact.
    # Jellyfin 12.0.0 supplies the compatible EF Core/SQLite runtime dependencies.
    local files=("$plugin_package_dir/JellyfinMod.dll" "$plugin_package_dir/logo.png" "$plugin_package_dir/meta.json")
    if ((plugin_web)); then
        files+=("$plugin_package_dir/jellyfinmod-web.zip")
    fi
    rsync --archive --compress --human-readable "${files[@]}" "$ssh_host:$plugin_dir/"
    if ((restart)); then
        restart_jellyfin_remote
    fi
}

case "$target:$mode" in
    plugin:local)
        deploy_plugin_from_local
        echo "JellyfinMod deployment completed successfully."
        exit 0
        ;;
esac

case "$mode" in
    host) deploy_on_host ;;
    local) deploy_from_local ;;
esac

echo "Jellyfin Web deployment completed successfully."
echo
echo "index.html is served no-cache, but clients that stay resident never go back"
echo "for it. Fully close and reopen the app on TVs and phones, or they will keep"
echo "running the bundle they started with."
